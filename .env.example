```dotenv
# ==========================================
# Runtime
# ==========================================
NODE_ENV=development
PORT=4000

# ==========================================
# Database - Local PostgreSQL
# Replace with your actual local credentials.
# ==========================================
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@localhost:5432/dukan_pro?schema=public

# ==========================================
# Authentication
# ==========================================
JWT_SECRET=replace_with_a_private_random_secret_at_least_16_characters
APP_BASE_URL=http://localhost:3000
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10
PASSWORD_SETUP_TOKEN_TTL_MINUTES=1440

# ==========================================
# CORS
# Comma-separated frontend origins.
# Do not add trailing slashes.
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000

# ==========================================
# Cloudflare R2 - Development
# Disabled by default.
# Enable only when you want to test image uploads.
# Use a separate development bucket if possible.
# ==========================================
R2_STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dukan-pro-product-images
R2_PUBLIC_URL_BASE=
```